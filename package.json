{
  "name": "spirchat",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "hub",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "start": "npm start -w hub",
    "dev:hub": "npm run dev -w hub",
    "dev:web": "npm run dev -w web",
    "test": "node --disable-warning=ExperimentalWarning --test packages/protocol/test/*.test.ts hub/test/*.test.ts simulator/*.test.ts",
    "simulate": "node simulator/sim.ts",
    "vectors": "node packages/protocol/scripts/vectors.ts > packages/protocol/test/vectors.json",
    "e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 e2e/*.test.ts",
    "typecheck": "tsc -p packages/protocol && tsc -p hub && tsc -p web && tsc -p e2e && tsc -p simulator"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
